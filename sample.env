ACCESS_TOKEN_SECRET=add_strong_secret_key
ACCESS_TOKEN_EXPIRY=1200 # In seconds (1200 = 20 minutes)
REF_TOKEN_SECRET=add_strong_secret_key
REF_TOKEN_EXPIRY=86400 # In seconds (86400 = 24 hr | 1 Day)

DB_HOST=localhost
DB_NAME=node_auth_api # Replace with your DB name
DB_USER=root # Replace with your DB user
DB_PASSWORD= #add your DB password here

# Trading Server Configuration
TRADING_SERVER_URL=http://localhost:3000
INTERNAL_API_KEY=your_internal_api_key_here

# Demo request reCAPTCHA
DEMO_RECAPTCHA_SITE_KEY=add_your_site_key_here
DEMO_RECAPTCHA_SECRET_KEY=add_your_secret_key_here

# Password Sync (Portal -> Trading Backend internal API)
PASSWORD_SYNC_TIMEOUT_MS=10000
PASSWORD_SYNC_MAX_RETRIES=5
PASSWORD_SYNC_RETRY_BASE_DELAY_MS=5000

# Investain SSO (shared JWT cookie)
JWT_SECRET=shared-investain-secret
JWT_EXPIRES_IN=7d

