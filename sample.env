ACCESS_TOKEN_SECRET=add_strong_secret_key
ACCESS_TOKEN_EXPIRY=1200 # In seconds (1200 = 20 minutes)
REF_TOKEN_SECRET=add_strong_secret_key
REF_TOKEN_EXPIRY=86400 # In seconds (86400 = 24 hr | 1 Day)

DB_HOST=localhost
DB_NAME=node_auth_api # Replace with your DB name
DB_USER=root # Replace with your DB user
DB_PASSWORD= #add your DB password here

# Trading Server Configuration
TRADING_SERVER_URL=http://localhost:3000
INTERNAL_API_KEY=your_internal_api_key_here

# Demo request reCAPTCHA
DEMO_RECAPTCHA_SITE_KEY=add_your_site_key_here
DEMO_RECAPTCHA_SECRET_KEY=add_your_secret_key_here

# Password Sync (Portal -> Trading Backend internal API)
PASSWORD_SYNC_TIMEOUT_MS=10000
PASSWORD_SYNC_MAX_RETRIES=5
PASSWORD_SYNC_RETRY_BASE_DELAY_MS=5000

# Investain SSO (shared JWT cookie)
JWT_SECRET=shared-investain-secret
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# OTP / SMS Verification Security
# ---------------------------------------------------------------------------
# Twilio Verify
TWILIO_ACCOUNT_SID=add_your_account_sid_here
TWILIO_AUTH_TOKEN=add_your_auth_token_here
TWILIO_VERIFY_SERVICE_SID=add_your_verify_service_sid_here

# Google reCAPTCHA v3 (required for platform = web)
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.7

# Android Play Integrity (required for platform = android when enabled)
# Certificate digests are comma-separated PLAY APP SIGNING SHA256 digests.
PLAY_INTEGRITY_ENABLED=false
PLAY_INTEGRITY_PACKAGE_NAME=
PLAY_INTEGRITY_CERTIFICATE_DIGESTS=
# Google Cloud project number (numeric) and service-account key JSON.
# Required for Express Integrity tokens (requestExpressIntegrityToken) which
# are NOT JWS format and must be decoded via Google's API.
PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=

# iOS App Attest (required for platform = ios when enabled)
APP_ATTEST_ENABLED=false
# Your Apple Developer Team ID, e.g. ABCDE12345. Combined with
# APP_ATTEST_APP_ID it forms the full Apple App ID (<TeamID>.<BundleID>)
# which is SHA-256 hashed for the App Attest RP ID. This must be set.
APPLE_TEAM_ID=
# iOS bundle identifier, e.g. com.investain.investain (NOT the full App ID).
APP_ATTEST_APP_ID=
APP_ATTEST_ENVIRONMENT=production

# Distributed OTP rate limiting (Redis) and cooldowns
OTP_IP_RATE_LIMIT=10
OTP_PHONE_RATE_LIMIT=5
OTP_DEVICE_RATE_LIMIT=5
OTP_RATE_LIMIT_WINDOW_SECONDS=3600
OTP_COOLDOWN_SECONDS=60

# Verification brute-force protection
OTP_VERIFY_ATTEMPT_LIMIT=5
OTP_VERIFY_WINDOW_SECONDS=300

# Challenge / integrity nonce lifetime
OTP_CHALLENGE_TTL_SECONDS=300
OTP_INTEGRITY_REPLAY_WINDOW_SECONDS=300

